{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darkroom",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",

  // PWA statica servita dallo stesso Worker (niente progetto Pages separato)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Una Durable Object per stanza: storage SQLite, consistenza forte e
  // scadenza affidata a un alarm. Tutto dentro il piano gratuito, senza
  // metodo di pagamento (a differenza di R2).
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
